# Required for running model benchmarks.
OPENROUTER_API_KEY=

# Server settings. Keep HOST on loopback unless you add authentication and TLS.
HOST=127.0.0.1
PORT=8796

# Optional OpenRouter request metadata.
OPENROUTER_HTTP_REFERER=http://localhost:8796/
OPENROUTER_APP_TITLE=Bench Marker

# Optional runtime locations. Defaults are relative to this repository.
# BENCH_MARKER_DATA_DIR=/var/lib/bench-marker
# BENCH_MARKER_DB=/var/lib/bench-marker/bench.db
# BENCH_MARKER_ENV_FILE=/etc/bench-marker.env

# Optional executable overrides.
# NODE_BIN=/usr/bin/node
# NPX_BIN=/usr/bin/npx
# FFMPEG_BIN=/usr/bin/ffmpeg
# CHROME_BIN=/usr/bin/chromium
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell

# Optional render controls.
# REMOTION_RENDER_TIMEOUT=300
# STRUDEL_RENDER_TIMEOUT=240
# STRUDEL_RENDER_DURATION=16
# STRUDEL_SAMPLE_RATE=44100
# SQUARE_IMAGE_TIMEOUT=60
# SQUARE_IMAGE_SIZE=1080
